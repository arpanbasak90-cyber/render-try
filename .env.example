APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=*
DEMO_MODE=false
AUTH_ENABLED=true
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
# DB_MODE options: postgres (Render Managed DB), mongo (MongoDB Atlas), sqlite, memory
DB_MODE=postgres
DATABASE_URL=postgresql://jalraksha_user:password@hostname:5432/jalraksha
MONGODB_URI=
MONGODB_DB_NAME=jalraksha
MONGODB_CONNECT_TIMEOUT_MS=1000
DEVICE_TRANSPORT=simulator
SERIAL_PORT=
SERIAL_BAUD=9600
SERIAL_BOOT_DELAY_S=2.0
SERIAL_REQUIRE_CHECKSUM=false
RAW_LOG_BUFFER_LINES=500
ACK_TIMEOUT_S=3
DEVICE_SILENCE_TIMEOUT_S=10
DEVICE_ID=UNO-001
READING_MODE=converted
ADC_REFERENCE_VOLTS=5.0
SAMPLE_INTERVAL_MS=1000
MIN_VALID_READINGS=20
STABILITY_WINDOW=10
MAX_SENSING_DURATION_S=120
FILTER_MODE=timed
FILTER_DURATION_S=
POST_FILTER_VERIFY=false
PURIFIER_CAPABILITIES=none
TDS_SENSOR_MAX_MGL=
SIMULATOR_DEFAULT_SCENARIO=clean_water
